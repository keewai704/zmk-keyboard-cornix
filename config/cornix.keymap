/*
 * 34-key (3x5 + 2 thumbs per side) Windows/iPad keymap for Cornix.
 *
 * The Cornix hardware keeps its 50-position matrix. This keymap enables only
 * the inner 34 positions and disables every outer key on all layers.
 *
 * SPDX-License-Identifier: MIT
 */

#include "includes/cornix54.h"

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 15
#include <dt-bindings/zmk/pointing.h>

#define WIN       0
#define IPAD      1
#define NUM       2
#define SYM       3
#define NAV_WIN   4
#define NAV_IPAD  5
#define DEVICE    6
#define MOUSE     7
#define SCROLL    8

#define HM_TAPPING_TERM       250
#define HM_TAPPING_TERM_FAST  200
#define HM_QUICK_TAP          175
#define HM_PRIOR_IDLE          70

/*
 * Active 34-key positions:
 *
 *   LT4 LT3 LT2 LT1 LT0                 RT0 RT1 RT2 RT3 RT4
 *   LM4 LM3 LM2 LM1 LM0                 RM0 RM1 RM2 RM3 RM4
 *   LB4 LB3 LB2 LB1 LB0                 RB0 RB1 RB2 RB3 RB4
 *                   LH1 LH0       RH0 RH1
 */
#define ACTIVE_LEFT  LT4 LT3 LT2 LT1 LT0 LM4 LM3 LM2 LM1 LM0 LB4 LB3 LB2 LB1 LB0
#define ACTIVE_RIGHT RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4
#define ACTIVE_THUMBS LH1 LH0 RH0 RH1

/ {
    behaviors {
        hm_l: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <HM_QUICK_TAP>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <ACTIVE_RIGHT ACTIVE_THUMBS>;
            hold-trigger-on-release;
        };

        hm_r: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <HM_QUICK_TAP>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <ACTIVE_LEFT ACTIVE_THUMBS>;
            hold-trigger-on-release;
        };

        hm_shift_l: home_row_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <HM_QUICK_TAP>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <ACTIVE_RIGHT ACTIVE_THUMBS>;
            hold-trigger-on-release;
        };

        hm_shift_r: home_row_shift_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <HM_QUICK_TAP>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <ACTIVE_LEFT ACTIVE_THUMBS>;
            hold-trigger-on-release;
        };

        thumb_lt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
        };
    };

    macros {
        /*
         * BT0 = Windows, BT1 = iPad. Selecting either profile also selects BLE
         * output and synchronizes the corresponding OS base layer.
         */
        win_bt0: win_bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <20>;
            bindings = <&bt BT_SEL 0>, <&out OUT_BLE>, <&to WIN>;
        };

        ipad_bt1: ipad_bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <20>;
            bindings = <&bt BT_SEL 1>, <&out OUT_BLE>, <&to IPAD>;
        };

        pair_current: pair_current {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <20>;
            bindings = <&bt BT_CLR>, <&out OUT_BLE>;
        };

        /*
         * iPad setup:
         * Settings > General > Keyboard > Hardware Keyboard > Modifier Keys
         * Remap Caps Lock to Globe. These macros then use Caps Lock as Globe.
         */
        globe_up: globe_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp UP>,
                <&macro_release &kp CAPSLOCK>;
        };

        globe_a: globe_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp A>,
                <&macro_release &kp CAPSLOCK>;
        };

        globe_c: globe_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp C>,
                <&macro_release &kp CAPSLOCK>;
        };

        globe_f: globe_f {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp F>,
                <&macro_release &kp CAPSLOCK>;
        };

        ctrl_globe_left: ctrl_globe_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press &kp LCTRL &kp CAPSLOCK>,
                <&macro_tap &kp LEFT>,
                <&macro_release &kp CAPSLOCK &kp LCTRL>;
        };

        ctrl_globe_right: ctrl_globe_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press &kp LCTRL &kp CAPSLOCK>,
                <&macro_tap &kp RIGHT>,
                <&macro_release &kp CAPSLOCK &kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <60>;
            key-positions = <LH1 LH0>;
            layers = <WIN IPAD>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <60>;
            key-positions = <RH0 RH1>;
            layers = <WIN IPAD>;
            bindings = <&kp LANG1>;
        };

        combo_device {
            timeout-ms = <75>;
            key-positions = <LH0 RH0>;
            bindings = <&mo DEVICE>;
            slow-release;
        };

        combo_mouse {
            timeout-ms = <75>;
            key-positions = <LH1 RH1>;
            bindings = <&mo MOUSE>;
            slow-release;
        };

        combo_tab {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            key-positions = <LB4 LB3>;
            layers = <WIN IPAD>;
            bindings = <&kp TAB>;
        };

        combo_delete {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            key-positions = <RB3 RB4>;
            layers = <WIN IPAD>;
            bindings = <&kp DEL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_layer {
            display-name = "Windows";
            bindings = <
                &none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none
                &none  &hm_l LGUI A  &hm_l LALT S  &hm_l RCTRL D  &hm_shift_l LSHFT F  &hm_l LCTRL G  &hm_r RCTRL H  &hm_shift_r RSHFT J  &hm_r RCTRL K  &hm_r RALT L  &hm_r RGUI SEMI  &none
                &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &none  &none  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                &none  &none  &none  &none  &thumb_lt 3 ESC  &thumb_lt 4 SPACE  &thumb_lt 4 ENTER  &thumb_lt 2 BSPC  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        ipad_layer {
            display-name = "iPad";
            bindings = <
                &none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none
                &none  &hm_l CAPSLOCK A  &hm_l LALT S  &hm_l LCTRL D  &hm_shift_l LSHFT F  &hm_l LGUI G  &hm_r RGUI H  &hm_shift_r RSHFT J  &hm_r RCTRL K  &hm_r RALT L  &hm_r CAPSLOCK SEMI  &none
                &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &none  &none  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                &none  &none  &none  &none  &thumb_lt 3 ESC  &thumb_lt 5 SPACE  &thumb_lt 5 ENTER  &thumb_lt 2 BSPC  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "Numbers";
            bindings = <
                &none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none
                &none  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &none
                &none  &kp GRAVE  &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &none  &none  &kp MINUS  &kp UNDER  &kp EQUAL  &kp PLUS  &kp DOT  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            display-name = "Symbols";
            bindings = <
                &none  &kp GRAVE  &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &none
                &none  &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &kp LT  &kp LPAR  &kp RPAR  &kp MINUS  &kp UNDER  &kp EQUAL  &none
                &none  &kp SEMI  &kp COLON  &kp SQT  &kp DQT  &kp GT  &none  &none  &kp PLUS  &kp BSLH  &kp PIPE  &kp FSLH  &kp QUESTION  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_win_layer {
            display-name = "Nav Windows";
            bindings = <
                &none  &kp LA(LS(TAB))  &kp LA(TAB)  &kp LG(TAB)  &kp LG(S)  &kp LG(LS(S))  &kp LC(HOME)  &kp HOME  &kp UP  &kp END  &kp LC(END)  &none
                &none  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LA(LEFT)  &kp LA(RIGHT)  &kp LC(W)  &kp LC(LEFT)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LC(RIGHT)  &none
                &none  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &kp LG(LEFT)  &kp LG(RIGHT)  &kp LG(UP)  &none  &none  &kp LC(LS(LEFT))  &kp LS(LEFT)  &kp DEL  &kp LS(RIGHT)  &kp LC(LS(RIGHT))  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_ipad_layer {
            display-name = "Nav iPad";
            bindings = <
                &none  &kp LG(LS(TAB))  &kp LG(TAB)  &globe_up  &kp LG(SPACE)  &kp LG(LS(N4))  &kp LG(UP)  &kp LG(LEFT)  &kp UP  &kp LG(RIGHT)  &kp LG(DOWN)  &none
                &none  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LG(LBKT)  &kp LG(RBKT)  &kp LG(W)  &kp LA(LEFT)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LA(RIGHT)  &none
                &none  &globe_a  &globe_c  &ctrl_globe_left  &ctrl_globe_right  &globe_f  &none  &none  &kp LA(LS(LEFT))  &kp LS(LEFT)  &kp DEL  &kp LS(RIGHT)  &kp LA(LS(RIGHT))  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        device_layer {
            display-name = "BT / Device";
            bindings = <
                &none  &win_bt0  &ipad_bt1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &tog 2  &tog 3  &tog 7  &tog 8  &none  &none
                &none  &pair_current  &bt BT_CLR_ALL  &bt BT_PRV  &bt BT_NXT  &none  &none  &none  &kp C_BRI_DN  &kp C_BRI_UP  &none  &none
                &none  &to 0  &to 1  &tog 4  &tog 5  &to 0  &none  &none  &bootloader  &sys_reset  &kp SYS_SLEEP  &out OUT_BLE  &out OUT_USB  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &none  &mkp MB4  &mmv MOVE_UP  &mkp MB5  &mkp MB1  &none  &none  &none  &none  &none  &none  &none
                &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB1  &mkp MB2  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &mkp MB3  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll_layer {
            display-name = "Scroll / Media";
            bindings = <
                &none  &none  &msc SCRL_UP  &none  &kp PG_UP  &kp C_VOL_UP  &kp HOME  &kp UP  &kp END  &kp C_BRI_UP  &none  &none
                &none  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &kp PG_DN  &kp C_VOL_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp C_BRI_DN  &none  &none
                &none  &kp C_MUTE  &kp C_PP  &kp C_PREV  &kp C_NEXT  &kp C_STOP  &none  &none  &mkp MB1  &mkp MB3  &mkp MB2  &none  &none  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
