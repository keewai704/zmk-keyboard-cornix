/*
 * 34-key (3x5 + 2 thumbs per side) Windows/iPad keymap for Cornix.
 *
 * Key behaviors use stock ZMK behaviors. The only external behavior is
 * cormoran's Runtime Sensor Rotate, required for DYA Studio encoder editing.
 *
 * SPDX-License-Identifier: MIT
 */

#include "includes/cornix54.h"

#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 15
#include <dt-bindings/zmk/pointing.h>

#define WIN       0
#define IPAD      1
#define NUM       2
#define SYM       3
#define NAV_WIN   4
#define NAV_IPAD  5
#define DEVICE    6
#define MOUSE     7
#define SCROLL    8

/ {
    behaviors {
        /*
         * DYA Studio runtime encoder bindings. Runtime settings override these
         * defaults per layer and persist without rebuilding the firmware.
         */
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_page: rsr_page {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp PG_UP>;
            ccw-binding = <&kp PG_DN>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <60>;
            key-positions = <LH1 LH0>;
            layers = <WIN IPAD>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <60>;
            key-positions = <RH0 RH1>;
            layers = <WIN IPAD>;
            bindings = <&kp LANG1>;
        };

        combo_device {
            timeout-ms = <75>;
            key-positions = <LH0 RH0>;
            bindings = <&mo DEVICE>;
            slow-release;
        };

        combo_mouse {
            timeout-ms = <75>;
            key-positions = <LH1 RH1>;
            bindings = <&mo MOUSE>;
            slow-release;
        };

        combo_tab {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            key-positions = <LB4 LB3>;
            layers = <WIN IPAD>;
            bindings = <&kp TAB>;
        };

        combo_delete {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            key-positions = <RB3 RB4>;
            layers = <WIN IPAD>;
            bindings = <&kp DEL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_layer {
            display-name = "Windows";
            bindings = <
                &none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none
                &none  &mt LGUI A  &mt LALT S  &mt RCTRL D  &mt LSHFT F  &mt LCTRL G  &mt RCTRL H  &mt RSHFT J  &mt RCTRL K  &mt RALT L  &mt RGUI SEMI  &none
                &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &none  &none  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                &none  &none  &none  &none  &lt SYM ESC  &lt NAV_WIN SPACE  &lt NAV_WIN ENTER  &lt NUM BSPC  &none  &none  &none  &none
            >;
            sensor-bindings = <&rsr_vol &rsr_page>;
        };

        ipad_layer {
            display-name = "iPad";
            bindings = <
                &none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none
                &none  &mt CAPSLOCK A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &mt LGUI G  &mt RGUI H  &mt RSHFT J  &mt RCTRL K  &mt RALT L  &mt CAPSLOCK SEMI  &none
                &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &none  &none  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                &none  &none  &none  &none  &lt SYM ESC  &lt NAV_IPAD SPACE  &lt NAV_IPAD ENTER  &lt NUM BSPC  &none  &none  &none  &none
            >;
            sensor-bindings = <&rsr_vol &rsr_page>;
        };

        num_layer {
            display-name = "Numbers";
            bindings = <
                &none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none
                &none  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &none
                &none  &kp GRAVE  &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &none  &none  &kp MINUS  &kp UNDER  &kp EQUAL  &kp PLUS  &kp DOT  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&rsr_vol &rsr_page>;
        };

        sym_layer {
            display-name = "Symbols";
            bindings = <
                &none  &kp GRAVE  &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &none
                &none  &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &kp LT  &kp LPAR  &kp RPAR  &kp MINUS  &kp UNDER  &kp EQUAL  &none
                &none  &kp SEMI  &kp COLON  &kp SQT  &kp DQT  &kp GT  &none  &none  &kp PLUS  &kp BSLH  &kp PIPE  &kp FSLH  &kp QUESTION  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&rsr_vol &rsr_page>;
        };

        nav_win_layer {
            display-name = "Nav Windows";
            bindings = <
                &none  &kp LA(LS(TAB))  &kp LA(TAB)  &kp LG(TAB)  &kp LG(S)  &kp LG(LS(S))  &kp LC(HOME)  &kp HOME  &kp UP  &kp END  &kp LC(END)  &none
                &none  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LA(LEFT)  &kp LA(RIGHT)  &kp LC(W)  &kp LC(LEFT)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LC(RIGHT)  &none
                &none  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &kp LG(LEFT)  &kp LG(RIGHT)  &kp LG(UP)  &none  &none  &kp LC(LS(LEFT))  &kp LS(LEFT)  &kp DEL  &kp LS(RIGHT)  &kp LC(LS(RIGHT))  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&rsr_vol &rsr_page>;
        };

        nav_ipad_layer {
            display-name = "Nav iPad";
            /*
             * Globe is Caps Lock remapped by iPadOS. With stock key behaviors,
             * Globe shortcuts use a one-shot/sticky Globe key followed by the
             * target key. Example: Globe Once -> Up opens the app switcher view.
             */
            bindings = <
                &none  &kp LG(LS(TAB))  &kp LG(TAB)  &sk CAPSLOCK  &kp LG(SPACE)  &kp LG(LS(N4))  &kp LG(UP)  &kp LG(LEFT)  &kp UP  &kp LG(RIGHT)  &kp LG(DOWN)  &none
                &none  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LG(LBKT)  &kp LG(RBKT)  &kp LG(W)  &kp LA(LEFT)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LA(RIGHT)  &none
                &none  &kp A  &kp C  &kp LC(LEFT)  &kp LC(RIGHT)  &kp F  &none  &none  &kp LA(LS(LEFT))  &kp LS(LEFT)  &kp DEL  &kp LS(RIGHT)  &kp LA(LS(RIGHT))  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&rsr_vol &rsr_page>;
        };

        device_layer {
            display-name = "BT / Device";
            bindings = <
                &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &tog NUM  &tog SYM  &tog MOUSE  &tog SCROLL  &none  &none
                &none  &bt BT_CLR  &bt BT_CLR_ALL  &bt BT_PRV  &bt BT_NXT  &none  &none  &none  &kp C_BRI_DN  &kp C_BRI_UP  &none  &none
                &none  &to WIN  &to IPAD  &tog NAV_WIN  &tog NAV_IPAD  &studio_unlock  &none  &none  &bootloader  &sys_reset  &kp SYS_SLEEP  &out OUT_BLE  &out OUT_USB  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&rsr_vol &rsr_page>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &none  &mkp MB4  &mmv MOVE_UP  &mkp MB5  &mkp MB1  &none  &none  &none  &none  &none  &none  &none
                &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB1  &mkp MB2  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &mkp MB3  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&rsr_vol &rsr_page>;
        };

        scroll_layer {
            display-name = "Scroll / Media";
            bindings = <
                &none  &none  &msc SCRL_UP  &none  &kp PG_UP  &kp C_VOL_UP  &kp HOME  &kp UP  &kp END  &kp C_BRI_UP  &none  &none
                &none  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &kp PG_DN  &kp C_VOL_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp C_BRI_DN  &none  &none
                &none  &kp C_MUTE  &kp C_PP  &kp C_PREV  &kp C_NEXT  &kp C_STOP  &none  &none  &mkp MB1  &mkp MB3  &mkp MB2  &none  &none  &none
                &none  &none  &none  &none  &trans  &trans  &trans  &trans  &none  &none  &none  &none
            >;
            sensor-bindings = <&rsr_vol &rsr_page>;
        };
    };
};